generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  name String
  role Role @default(STUDENT)
  createdAt DateTime @default(now())
  organizer Organizer?
  events Event[]
  bookmarks Bookmark[]
  notifications Notification[]
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum Recommendation {
  APPROVE
  REQUEST_CHANGES
  MANUAL_REVIEW
  REJECT
}
model Organizer {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  organizationName String
  description String?
  websiteUrl String?
  verified Boolean @default(false)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  events Event[]
}

model Event {
  id String @id @default(uuid()) @db.Uuid
  organizerId String @db.Uuid
  createdById String @db.Uuid
  title String
  description String
  category String
  eventDate DateTime
  startTime String
  endTime String
  venue String
  location String
  registrationUrl String?
  contactEmail String
  contactPhone String?
  posterUrl String?
  status EventStatus @default(DRAFT)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organizer Organizer @relation(fields:[organizerId], references:[id], onDelete:Cascade)
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Cascade)
  submissions EventSubmission[]
  verification VerificationResult?
  bookmarks Bookmark[]
  @@index([status])
  @@index([eventDate])
  @@index([category])
}

model EventSubmission {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  status EventStatus
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  adminNote String?
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  @@index([status])
}

model VerificationResult {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique @db.Uuid
  qualityScore Int
  trustScore Int
  riskLevel String
  confidence Int
  recommendation Recommendation
  summary String
  explanation String?
  suggestedActions Json?
  descriptionResult Json
  imageResult Json
  urlResult Json
  duplicateResult Json
  findings Finding[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
}

model Finding {
  id String @id @default(uuid()) @db.Uuid
  verificationId String @db.Uuid
  severity String
  source String
  message String
  verification VerificationResult @relation(fields:[verificationId], references:[id], onDelete:Cascade)
  @@index([verificationId])
}

model Bookmark {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  eventId String @db.Uuid
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  @@unique([userId,eventId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  title String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
