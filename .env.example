# ============================================================
# AI Event Quality & Verification Scanner - Environment Config
# ============================================================
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control
# ============================================================

# ============================================================
# BACKEND CONFIGURATION
# ============================================================
BACKEND_URL=http://localhost:3001
BACKEND_PORT=3001
NODE_ENV=development

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_event_scanner
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_event_scanner
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================================
# AUTHENTICATION
# ============================================================
JWT_SECRET=your_jwt_secret_here_change_in_production_min_32_chars
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_min_32_chars
JWT_REFRESH_EXPIRY=30d
BCRYPT_ROUNDS=10

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# FILE UPLOAD
# ============================================================
FILE_UPLOAD_PATH=./uploads
FILE_UPLOAD_TEMP_PATH=./temp
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14

# ============================================================
# SECURITY
# ============================================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
SESSION_SECRET=your_session_secret_here_change_in_production
SECURE_COOKIES=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# EMAIL (Future Feature)
# ============================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ============================================================
# FILE STORAGE
# ============================================================
# Options: disk (local filesystem) or s3 (AWS S3)
STORAGE_TYPE=disk
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ============================================================
# REDIS (Optional - for caching/sessions)
# ============================================================
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# STRIPE (Future - for premium features)
# ============================================================
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# SENTRY (Optional - error tracking)
# ============================================================
SENTRY_DSN=

# ============================================================
# ANALYTICS (Optional)
# ============================================================
GOOGLE_ANALYTICS_ID=
POSTHOG_API_KEY=

# ============================================================
# ENVIRONMENT-SPECIFIC NOTES
# ============================================================
# Development: Use localhost, relaxed security
# Staging: Use staging domain, strict security headers
# Production: Use production domain, strict security, HTTPS only

# AI
GEMINI_API_KEY=
